# Copy to .env and replace both passwords. Never commit the populated .env.
# These databases and ports are for local development only.
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/noghterangi
DB_USERNAME=noghterangi
DB_PASSWORD=replace-with-a-local-development-password

TEST_DB_PORT=5433
TEST_DB_URL=jdbc:postgresql://localhost:5433/noghterangi_test
TEST_DB_USERNAME=noghterangi_test
TEST_DB_PASSWORD=replace-with-a-different-local-test-password

# Required administrator configuration. Keep the BCrypt hash single-quoted in .env.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Set true when serving over HTTPS; false is only for local HTTP development.
SESSION_COOKIE_SECURE=false

# Local image files; relative to the application's working directory.
MEDIA_STORAGE_PATH=uploads/media
